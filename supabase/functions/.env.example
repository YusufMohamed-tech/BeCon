# Secrets for Supabase Edge Functions.
# Set these with: supabase secrets set --env-file ./supabase/functions/.env

# Moyasar
MOYASAR_PUBLISHABLE_KEY=pk_test_xxx
MOYASAR_SECRET_KEY=sk_test_xxx
MOYASAR_WEBHOOK_SECRET=choose-a-strong-shared-secret

# ZATCA (Fatoora) seller identity for e-invoice QR
ZATCA_SELLER_NAME=BeCon
ZATCA_VAT_NUMBER=300000000000003

# Firebase Cloud Messaging — paste the full service-account JSON on one line
FCM_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","token_uri":"https://oauth2.googleapis.com/token"}

# Provided automatically by Supabase at runtime (listed for local reference):
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
